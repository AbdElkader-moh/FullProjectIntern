  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "exec": [
          "// Make sure every request in this collection carries a valid JWT,",
          "// even if it's run on its own instead of after a Sign In request.",
          "// If we don't have one cached yet, silently register + log in a",
          "// throwaway user and capture the token from the login response.",
          "if (!pm.collectionVariables.get('authToken')) {",
          "    const email = `auto_auth_${Date.now()}@test.com`;",
          "    const password = 'Auto@12345';",
          "",
          "    pm.sendRequest({",
          "        url: pm.variables.get('baseUrl') + '/api/users/signup',",
          "        method: 'POST',",
          "        header: { 'Content-Type': 'application/json' },",
          "        body: {",
          "            mode: 'raw',",
          "            raw: JSON.stringify({ email, firstName: 'Auto', lastName: 'Auth', password, profilePicture: '' })",
          "        }",
          "    }, (err, res) => {",
          "        pm.sendRequest({",
          "            url: pm.variables.get('baseUrl') + '/api/users/login',",
          "            method: 'POST',",
          "            header: { 'Content-Type': 'application/json' },",
          "            body: {",
          "                mode: 'raw',",
          "                raw: JSON.stringify({ email, password })",
          "            }",
          "        }, (err2, res2) => {",
          "            const authHeader = res2 && res2.headers ? res2.headers.get('Authorization') : null;",
          "            if (authHeader) {",
          "                pm.collectionVariables.set('authToken', authHeader.replace(/^Bearer\\s/, ''));",
          "                console.log('Auto-provisioned a JWT for this run.');",
          "            } else {",
          "                console.warn('Auto auth failed - no Authorization header returned from login. Sensor/user requests may 401.');",
          "            }",
          "        });",
          "    });",
          "}"
        ]
      }
    }
  ],
