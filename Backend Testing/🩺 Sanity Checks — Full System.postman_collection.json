        {
          "name": "SAN-AUTH-002 | POST /login — Happy Path (200 + cookie) Copy",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Register a fresh user so login is guaranteed to succeed",
                  "const email = `login_ok_${Date.now()}@test.com`;",
                  "const password = 'abc123';",
                  "pm.collectionVariables.set('loginEmail', email);",
                  "pm.collectionVariables.set('loginPassword', password);",
                  "",
                  "pm.sendRequest({",
                  "  url: pm.variables.get('baseUrl') + '/api/users/signup',",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json' },",
                  "  body: {",
                  "    mode: 'raw',",
                  "    raw: JSON.stringify({ email, firstName: 'Login', lastName: 'Test', password, profilePicture: '' })",
                  "  }",
                  "}, (err, res) => console.log('Signup for login test:', res.code));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// TC-048",
                  "pm.test('Status is 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has success message', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('message');",
                  "  pm.expect(body.message.toLowerCase()).to.include('success');",
                  "});",
                  "",
                  "pm.test('Authorization header with JWT is returned', () => {",
                  "  const authHeader = pm.response.headers.get('Authorization');",
                  "  pm.expect(authHeader).to.exist;",
                  "  pm.expect(authHeader).to.match(/^Bearer\\s.+/);",
                  "});",
                  "",
                  "// Save the JWT so it can be sent as a Bearer token on subsequent requests",
                  "const authHeader = pm.response.headers.get('Authorization');",
                  "const token = authHeader ? authHeader.replace(/^Bearer\\s/, '') : '';",
                  "pm.collectionVariables.set('authToken', token);",
                  "console.log('JWT saved:', token ? token.substring(0, 20) + '...' : '(none)');"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
