                  "  }",
                  "}, (err, res) => {",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/api/users/login',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ email, password }) }",
                  "  }, (err2, res2) => console.log('Login for PUT test:', res2.code));",
