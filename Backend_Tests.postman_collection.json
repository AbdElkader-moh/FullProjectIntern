              "script": {
                "exec": [
                  "// Register + login fresh user so session is available",
                  "const email = `put_test_${Date.now()}@test.com`;",
                  "const password = 'abc123';",
                  "pm.collectionVariables.set('putEmail', email);",
                  "",
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get('baseUrl') + '/api/users/signup',",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json' },",
