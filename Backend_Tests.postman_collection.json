      "name": "🟢 Sign Up",
      "item": [
        {
          "name": "TC-044 | POST /signup — Happy Path (all valid fields)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// TC-044: POST /signup — all valid fields (happy path)",
                  "pm.test('Status is 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has user fields', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.expect(body).to.have.property('email');",
                  "  pm.expect(body).to.have.property('firstName');",
                  "  pm.expect(body).to.have.property('lastName');",
                  "});",
                  "",
                  "pm.test('Email matches what was sent', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.email).to.eql(pm.collectionVariables.get('testEmail'));",
                  "});",
                  "",
                  "pm.test('Response does NOT contain plain-text password', () => {",
                  "  const body = pm.response.json();",
                  "  if (body.password) {",
                  "    pm.expect(body.password).to.not.eql(pm.collectionVariables.get('testPassword'));",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate a unique email each run to avoid duplicate conflicts",
                  "const ts = Date.now();",
                  "const email = `be_test_${ts}@test.com`;",
                  "pm.collectionVariables.set('testEmail', email);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"password\": \"{{testPassword}}\",\n  \"profilePicture\": \"\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/signup", "host": ["{{baseUrl}}"], "path": ["api", "users", "signup"] }
          }
        },
