    {
      "name": "🔵 Profile — GET /me",
      "item": [
        {
          "name": "TC-052 | GET /me — Authenticated user gets profile (200)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Register + login so session cookie is set in Postman cookie jar",
                  "const email = `me_test_${Date.now()}@test.com`;",
                  "const password = 'abc123';",
                  "pm.collectionVariables.set('meEmail', email);",
                  "pm.collectionVariables.set('mePassword', password);",
                  "",
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get('baseUrl') + '/api/users/signup',",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json' },",
                  "  body: {",
                  "    mode: 'raw',",
                  "    raw: JSON.stringify({ email, firstName: 'Me', lastName: 'Test', password, profilePicture: '' })",
                  "  }",
                  "}, (err, res) => {",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/api/users/login',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: {",
                  "      mode: 'raw',",
                  "      raw: JSON.stringify({ email, password })",
                  "    }",
                  "  }, (err2, res2) => console.log('Login for /me test:', res2.code));",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// TC-052",
                  "pm.test('Status is 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains user profile fields', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.expect(body).to.have.property('email');",
                  "  pm.expect(body).to.have.property('firstName');",
                  "  pm.expect(body).to.have.property('lastName');",
                  "});",
                  "",
                  "pm.test('Email matches logged-in user', () => {",
                  "  pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('meEmail'));",
                  "});",
                  "",
                  "// Save user id for later PUT test",
                  "pm.collectionVariables.set('meUserId', pm.response.json().id);"
                ],
                "type": "text/javascript"
              }
            }
