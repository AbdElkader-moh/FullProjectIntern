        {
          "name": "TC-POST-TRF-021 | Verify posted data is retrievable via GET",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "// After POST verify data is saved via GET",
                  "pm.sendRequest({",
                  "    url: pm.variables.get('sensorBaseUrl') + '/api/sensors/traffic?location=VerifyCity999&page=0&size=10',",
                  "    method: 'GET'",
                  "}, (err, res) => {",
                  "    pm.test('Posted record is retrievable via GET', () => {",
                  "        const body = res.json();",
                  "        pm.expect(body.totalElements).to.be.above(0);",
                  "        const found = body.content.some(r => r.location === 'VerifyCity999');",
                  "        pm.expect(found).to.be.true;",
                  "    });",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
