{
  "info": {
    "name": "GET /api/sensors/traffic/congestion-summary",
    "description": "Automated test collection for GET /api/sensors/traffic/congestion-summary endpoint",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "sensorBaseUrl",
      "value": "http://localhost:8081"
    }
  ],
  "item": [
    {
      "name": "\u2705 Happy Path",
      "item": [
        {
          "name": "TC-GET-TCS-001 | Status 200 and response is an object",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is an object not an array', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('object');",
                  "  pm.expect(body).to.not.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sensorBaseUrl}}/api/sensors/traffic/congestion-summary",
              "host": [
                "{{sensorBaseUrl}}"
              ],
              "path": [
                "api",
                "sensors",
                "traffic",
                "congestion-summary"
              ]
            }
          }
        },
        {
          "name": "PRE | Fetch stats and save collection variables",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('totalRecords', body.totalRecords);",
                  "pm.collectionVariables.set('highCongestionCount', body.highCongestionCount);",
                  "pm.collectionVariables.set('severeCongestionCount', body.severeCongestionCount);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sensorBaseUrl}}/api/sensors/traffic/stats",
              "host": [
                "{{sensorBaseUrl}}"
              ],
              "path": [
                "api",
                "sensors",
                "traffic",
                "stats"
              ]
            }
          }
        },
        {
          "name": "TC-GET-TCS-002 | All congestion level keys exist with correct types and cross-check stats",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('All 4 congestion level keys exist with correct types', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('Low').that.is.a('number');",
                  "  pm.expect(body).to.have.property('Moderate').that.is.a('number');",
                  "  pm.expect(body).to.have.property('High').that.is.a('number');",
                  "  pm.expect(body).to.have.property('Severe').that.is.a('number');",
                  "});",
                  "pm.test('High count matches stats endpoint', () => {",
                  "  const body = pm.response.json();",
                  "  const highFromStats = pm.collectionVariables.get('highCongestionCount');",
                  "  pm.expect(body.High).to.eql(Number(highFromStats));",
                  "});",
                  "pm.test('Severe count matches stats endpoint', () => {",
                  "  const body = pm.response.json();",
                  "  const severeFromStats = pm.collectionVariables.get('severeCongestionCount');",
                  "  pm.expect(body.Severe).to.eql(Number(severeFromStats));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sensorBaseUrl}}/api/sensors/traffic/congestion-summary",
              "host": [
                "{{sensorBaseUrl}}"
              ],
              "path": [
                "api",
                "sensors",
                "traffic",
                "congestion-summary"
              ]
            }
          }
        },
        {
          "name": "TC-GET-TCS-003 | All counts are non-negative",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('All congestion level counts are non-negative', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.Low).to.be.at.least(0);",
                  "  pm.expect(body.Moderate).to.be.at.least(0);",
                  "  pm.expect(body.High).to.be.at.least(0);",
                  "  pm.expect(body.Severe).to.be.at.least(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sensorBaseUrl}}/api/sensors/traffic/congestion-summary",
              "host": [
                "{{sensorBaseUrl}}"
              ],
              "path": [
                "api",
                "sensors",
                "traffic",
                "congestion-summary"
              ]
            }
          }
        }
      ]
    }
  ]
}