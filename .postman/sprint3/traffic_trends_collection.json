{
  "info": {
    "name": "GET /api/sensors/traffic/trends",
    "description": "Automated test collection for GET /api/sensors/traffic/trends endpoint",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "sensorBaseUrl",
      "value": "http://localhost:8081"
    }
  ],
  "item": [
    {
      "name": "✅ Happy Path",
      "item": [
        {
          "name": "TC-GET-TRD-001 | Status 200 and returns array",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is an array', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sensorBaseUrl}}/api/sensors/traffic/trends",
              "host": ["{{sensorBaseUrl}}"],
              "path": ["api", "sensors", "traffic", "trends"]
            }
          }
        },
        {
          "name": "TC-GET-TRD-002 | Array is not empty",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Array is not empty', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sensorBaseUrl}}/api/sensors/traffic/trends",
              "host": ["{{sensorBaseUrl}}"],
              "path": ["api", "sensors", "traffic", "trends"]
            }
          }
        },
        {
          "name": "TC-GET-TRD-003 | Verify field types in each record",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Each record has correct field types', () => {",
                  "  const body = pm.response.json();",
                  "  body.forEach(record => {",
                  "    pm.expect(record).to.have.property('timestamp').that.is.a('string');",
                  "    pm.expect(record).to.have.property('trafficDensity').that.is.a('number');",
                  "    pm.expect(record).to.have.property('avgSpeed').that.is.a('number');",
                  "  });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sensorBaseUrl}}/api/sensors/traffic/trends",
              "host": ["{{sensorBaseUrl}}"],
              "path": ["api", "sensors", "traffic", "trends"]
            }
          }
        },
        {
          "name": "TC-GET-TRD-004 | Timestamp is valid ISO 8601",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Each timestamp is a valid ISO 8601 date', () => {",
                  "  const body = pm.response.json();",
                  "  body.forEach(record => {",
                  "    pm.expect(isNaN(new Date(record.timestamp).getTime())).to.be.false;",
                  "  });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sensorBaseUrl}}/api/sensors/traffic/trends",
              "host": ["{{sensorBaseUrl}}"],
              "path": ["api", "sensors", "traffic", "trends"]
            }
          }
        },
        {
          "name": "TC-GET-TRD-005 | Records ordered by timestamp ascending",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Records are ordered by timestamp descending', () => {",
                  "  const body = pm.response.json();",
                  "  const timestamps = body.map(r => new Date(r.timestamp));",
                  "  for (let i = 0; i < timestamps.length - 1; i++) {",
                  "    pm.expect(timestamps[i]).to.be.at.least(timestamps[i+1]);",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sensorBaseUrl}}/api/sensors/traffic/trends",
              "host": ["{{sensorBaseUrl}}"],
              "path": ["api", "sensors", "traffic", "trends"]
            }
          }
        },
        {
          "name": "TC-GET-TRD-006 | trafficDensity and avgSpeed are non-negative",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('trafficDensity and avgSpeed are non-negative', () => {",
                  "  const body = pm.response.json();",
                  "  body.forEach(record => {",
                  "    pm.expect(record.trafficDensity).to.be.at.least(0);",
                  "    pm.expect(record.avgSpeed).to.be.at.least(0);",
                  "  });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sensorBaseUrl}}/api/sensors/traffic/trends",
              "host": ["{{sensorBaseUrl}}"],
              "path": ["api", "sensors", "traffic", "trends"]
            }
          }
        }
      ]
    }
  ]
}
