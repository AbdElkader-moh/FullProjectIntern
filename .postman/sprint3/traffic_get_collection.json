          "name": "TC-GET-TRF-001 | No params \u2014 Default pagination",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has content array', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('content');",
                  "  pm.expect(body.content).to.be.an('array');",
                  "});",
                  "pm.test('Default page size is 20', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.pageable.pageSize).to.eql(20);",
                  "});",
                  "pm.test('Response has pagination fields', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('totalElements');",
                  "  pm.expect(body).to.have.property('totalPages');",
                  "  pm.expect(body).to.have.property('first');",
                  "  pm.expect(body).to.have.property('last');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
