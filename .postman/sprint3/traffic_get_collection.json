            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has content array', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.content).to.be.an('array');",
                  "});",
                  "pm.test('Records sorted by timestamp descending', () => {",
                  "  const body = pm.response.json();",
                  "  const timestamps = body.content.map(r => new Date(r.timestamp));",
                  "  for (let i = 0; i < timestamps.length - 1; i++) {",
                  "    pm.expect(timestamps[i]).to.be.at.least(timestamps[i+1]);",
                  "  }",
                  "});",
                  "pm.test('Records with equal timestamps sorted by location ascending', () => {",
                  "  const body = pm.response.json();",
                  "  for (let i = 0; i < body.content.length - 1; i++) {",
                  "    const curr = body.content[i];",
                  "    const next = body.content[i + 1];",
                  "    const sameTimestamp = curr.timestamp === next.timestamp;",
                  "    if (sameTimestamp) {",
                  "      pm.expect(curr.location.localeCompare(next.location)).to.be.at.most(0);",
                  "    }",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
