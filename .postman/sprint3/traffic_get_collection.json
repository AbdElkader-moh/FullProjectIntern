                  "    pm.expect(record).to.have.property('location').that.is.a('string');",
                  "    pm.expect(record).to.have.property('timestamp').that.is.a('string');",
                  "    pm.expect(record).to.have.property('trafficDensity').that.is.a('number');",
                  "    pm.expect(record).to.have.property('avgSpeed').that.is.a('number');",
                  "    pm.expect(record).to.have.property('congestionLevel').that.is.a('string');",
                  "  });",
                  "});",
                  "pm.test('Timestamp is valid ISO 8601 format', () => {",
                  "  const body = pm.response.json();",
                  "  body.content.forEach(record => {",
                  "    pm.expect(isNaN(new Date(record.timestamp).getTime())).to.be.false;",
                  "  });",
                  "});",
                  "pm.test('congestionLevel is one of allowed enum values', () => {",
                  "  const body = pm.response.json();",
                  "  const allowed = ['Low', 'Moderate', 'High', 'Severe'];",
                  "  body.content.forEach(record => {",
                  "    pm.expect(allowed).to.include(record.congestionLevel);",
                  "  });",
                  "});",
                  "pm.test('trafficDensity and avgSpeed are non-negative', () => {",
                  "  const body = pm.response.json();",
                  "  body.content.forEach(record => {",
